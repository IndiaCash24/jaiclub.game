rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // App configurations, banners, games catalog
    match /app_settings/{document} {
      allow read, write: if true;
    }

    // User profile and real-time wallet balance
    match /users/{userId} {
      allow read, write: if true;
    }

    // Deposits, withdrawals and game logs
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Global default rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
